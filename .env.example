# ============================================================================
#  Claude Phone für FreePBX – Secrets & Netzwerk
#  cp .env.example .env   → Werte eintragen.  Was welche Nebenstelle macht,
#  steht NICHT hier, sondern im Telefonbuch in docker-compose.yml.
# ============================================================================

# ── Netzwerk ────────────────────────────────────────────────────────────────
# LAN-IP des Docker-Hosts (docker.mrz.ip) – landet im SDP, sonst kein Audio
EXTERNAL_IP=192.168.188.222

# ── FreePBX ─────────────────────────────────────────────────────────────────
SIP_DOMAIN=pbx.mrz.ip
SIP_REGISTRAR=192.168.188.42
DRACHTIO_SIP_PORT=5060

# PJSIP-Secrets der Nebenstellen (FreePBX → Applications → Extensions)
EXT_999_PASSWORD=
EXT_900_PASSWORD=
EXT_901_PASSWORD=

# ── Claude (für die Agent-Container) ────────────────────────────────────────
# Erzeugen auf einem Rechner mit Claude-Abo:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# ── Sprache ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=            # Whisper (Spracherkennung)
ELEVENLABS_API_KEY=        # Sprachausgabe
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal

# ── Interna (meist nicht ändern) ────────────────────────────────────────────
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$
HTTP_PORT=3000
WS_PORT=3001
AUDIO_DIR=/app/audio
