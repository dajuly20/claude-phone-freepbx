# ============================================================================
#  Claude Phone für FreePBX – Secrets & Netzwerk
#  cp .env.example .env   → Werte eintragen.  Was welche Nebenstelle macht,
#  steht NICHT hier, sondern im Telefonbuch in docker-compose.yml.
# ============================================================================

# ── Netzwerk ────────────────────────────────────────────────────────────────
# LAN-IP des Docker-Hosts (docker.mrz.ip) – landet im SDP, sonst kein Audio
EXTERNAL_IP=192.168.188.222

# ── FreePBX ─────────────────────────────────────────────────────────────────
SIP_DOMAIN=pbx.mrz.ip
SIP_REGISTRAR=192.168.188.42
DRACHTIO_SIP_PORT=5060
# Live-Telefonbuch der Anlage für die Vermittlung (700), 5 Min gecacht.
# Nicht erreichbar → Fallback auf "directory" aus extensions.yml.
PBX_DIRECTORY_URL=http://192.168.188.42/nummernplan/telefonbuch.json

# Julians Adressbuch (vCard aus Google-Kontakten) liegt in ./private/contacts.vcf
# (nicht im Git). Anrufer von außen werden daraus mit Namen erkannt; die
# Einträge selbst bekommt die Vermittlung nur, wenn einer dieser Anschlüsse
# anruft (Komma-getrennt: Nebenstellen und Handy). Die Telefone melden sich mit
# ihrer Gerätenummer (401, 502, 601 …), nicht mit der Wählnummer (221–223):
# z.B. 401,502,601,221,222,223,+49170…
OWNER_CALLER_IDS=
# CONTACTS_FILE=/app/private/contacts.vcf
# CONTACTS_COUNTRY_CODE=49

# PJSIP-Secrets der Nebenstellen (FreePBX → Applications → Extensions)
EXT_700_PASSWORD=
EXT_701_PASSWORD=
EXT_702_PASSWORD=
EXT_703_PASSWORD=

# ── Home Assistant (Nebenstelle 703) ────────────────────────────────────────
# Token als HA-Benutzer "claude-phone" (kein Admin) erzeugen:
#   http://ha.mrz.ip lokal anmelden → Profil → Sicherheit → Langlebiges Token
HA_URL=http://ha.mrz.ip
HA_TOKEN=

# ── Rückruf / ausgehende Anrufe (POST /api/outbound-call) ───────────────────
# +49… wird zu 0…, andere +… zu 00…; optional Präfix der Outbound-Route
PSTN_COUNTRY_CODE=49
PSTN_DIAL_PREFIX=

# ── Claude (für die Agent-Container) – EINS von beiden reicht ───────────────
# a) Claude-Abo, keine Extrakosten.  Erzeugen mit:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# b) API-Key, Abrechnung pro Nutzung (beginnt mit sk-ant-api…)
#    Holen:     https://console.anthropic.com/settings/keys  → „Create Key“
#    Guthaben:  https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=

# ── Sprache ─────────────────────────────────────────────────────────────────
# Spracherkennung: homeassistant = über Home Assistant (z.B. Home Assistant Cloud,
# braucht HA_URL + HA_TOKEN unten), openai = OpenAI Whisper (braucht OPENAI_API_KEY)
STT_PROVIDER=homeassistant
HA_STT_PROVIDER=stt.home_assistant_cloud
OPENAI_API_KEY=            # nur für STT_PROVIDER=openai
ELEVENLABS_API_KEY=        # Sprachausgabe
ELEVENLABS_VOICE_ID=8H6qI5XrorT00BcdvDlm   # „Railway – Vintage Station Announcement“ (de, männlich)
# Sind die ElevenLabs-Credits alle (oder ElevenLabs gestört), spricht Home
# Assistant (gleiches HA_URL/HA_TOKEN). Nach "Kontingent leer" wird ElevenLabs
# 30 Min übersprungen, danach wieder probiert. TTS_FALLBACK=none schaltet das ab.
# TTS_FALLBACK=homeassistant
# HA_TTS_ENGINE=tts.home_assistant_cloud
# HA_TTS_VOICE=KatjaNeural          # leer = Standardstimme von HA Cloud (de-DE)
# TTS_ELEVENLABS_PAUSE_MIN=30
# Feste Sätze (bis 400 Zeichen) werden je Stimme einmal erzeugt und im Volume
# "audio" gespeichert – Begrüßung, Menü, "Einen Moment" kosten so nur einmal.
# Unbenutzt 30 Tage → gelöscht. TTS_CACHE=off schaltet ab.
# TTS_CACHE_MAX_CHARS=400
# TTS_CACHE_DAYS=30

# ── Interna (meist nicht ändern) ────────────────────────────────────────────
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$
HTTP_PORT=3000
WS_PORT=3001
AUDIO_DIR=/app/audio
